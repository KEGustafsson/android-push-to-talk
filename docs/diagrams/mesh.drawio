<mxfile host="Electron" type="device"><diagram id="mesh" name="A crew of three phones"><mxGraphModel dx="1" dy="1" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Example: three phones, two kinds of link, everyone hears everyone" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="a" value="Phone A
Wi-Fi Aware + Bluetooth" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="b" value="Phone B
Wi-Fi Aware only" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="c" value="Phone C
Bluetooth only
(no Wi-Fi Aware hardware)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="n1" value="A hears B over Aware and forwards it to C over Bluetooth (relay). C hears A directly.
B reaches C only through A: on B&#x27;s Status screen C shows as &quot;1 hop&quot;.
Each packet carries a hop count (4 by default) so nothing circulates forever,
and a seen-list drops copies that arrive by two paths." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="500" height="90" as="geometry"/></mxCell><mxCell id="n2" value="On a boat with a WLAN router, WLAN is the third kind of link; a phone with WLAN and
