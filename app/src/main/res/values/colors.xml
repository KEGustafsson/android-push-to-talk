<?xml version="1.0" encoding="utf-8"?>
<!--
    The Radio look: teal on charcoal, always dark. A cockpit app is used at night more than
    a normal phone app, and the design was chosen for this exact palette, so there is no
    light variant and no dynamic colour.
-->
<resources>
    <color name="primary">#4FD8EB</color>
    <color name="on_primary">#00363D</color>
    <color name="primary_container">#004F58</color>
    <color name="on_primary_container">#97F0FF</color>
    <color name="secondary">#B1CBD0</color>
    <color name="on_secondary">#1C3439</color>
    <color name="secondary_container">#334B4F</color>
    <color name="on_secondary_container">#CDE7EC</color>
    <color name="error">#FFB4AB</color>
    <color name="on_error">#690005</color>

    <color name="surface">#101416</color>
    <color name="surface_card">#171C1E</color>
    <color name="outline">#2E3436</color>
    <color name="text">#E1E3E3</color>
    <color name="text_dim">#899294</color>
    <color name="text_teal_dim">#7FA6AC</color>
    <color name="tile_selected">#0F2A2F</color>
    <color name="dot_idle">#3A4547</color>
    <!-- The green of whoever is talking. -->
    <color name="talking">#81C784</color>
